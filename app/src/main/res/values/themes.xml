<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- Base application theme. -->
    <style name="Base.Theme.Saharaa" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Light Theme Attributes -->
        <item name="colorPrimary">@color/brown_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brown_accent</item>
        <item name="colorOnPrimaryContainer">@color/brown_primary_dark</item>
        
        <item name="colorSecondary">@color/brown_light</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/background_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Saharaa" parent="Base.Theme.Saharaa" />
    
    <style name="OtpBoxStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#1F2937</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.Saharaa.Splash" parent="Theme.Saharaa">
        <item name="android:windowBackground">@color/splash_background_light</item>
    </style>
</resources>