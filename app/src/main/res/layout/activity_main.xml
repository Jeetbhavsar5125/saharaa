<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brown_main_bg"
    tools:context=".activities.MainActivity">

    <!-- Top Info Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Saharaa Vision"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_search_pill"
            android:backgroundTint="@color/surface_brown_light"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/brown_primary_dark"
            android:contentDescription="Settings"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp"/>

        <ImageView
            android:id="@+id/btnHistory"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_search_pill"
            android:backgroundTint="@color/surface_brown_light"
            android:padding="14dp"
            android:src="@drawable/ic_history_clock"
            app:tint="@color/brown_primary_dark"
            android:contentDescription="History"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:weightSum="10"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Initial Prompt -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tap below to Scan or Say 'Scan'"
            android:textColor="@color/text_secondary_dark"
            android:textSize="18sp"
            android:textStyle="italic" />

        <!-- Main Button: Object Scan -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnScanObject"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5.5"
            app:cardBackgroundColor="@color/surface_brown_light"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_scan_object"
                    app:tint="@color/brown_primary_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Identify Object"
                    android:textColor="@color/brown_primary_dark"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Secondary Button: Barcode -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnScanBarcode"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.5"
            app:cardBackgroundColor="@color/brown_primary"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_barcode_scanner"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Scan Barcode"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@drawable/ic_mic"
        app:fabSize="normal"
        app:backgroundTint="@color/brown_primary"
        app:tint="@color/white"
        android:contentDescription="Tap to Speak"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Voice Status Banner -->
    <TextView
        android:id="@+id/tvVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎤 Listening..."
        android:textColor="@color/white"
        android:textSize="14sp"
        android:background="@drawable/bg_search_pill"
        android:backgroundTint="#80000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>