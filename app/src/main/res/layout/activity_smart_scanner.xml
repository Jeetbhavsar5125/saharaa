<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ─── Camera Preview (full screen) ─────────────────────────────────── -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- ─── Top Bar: Mode badge ───────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_search_pill"
        android:backgroundTint="#CC000000"
        android:padding="12dp"
        android:layout_marginTop="48dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iconMode"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_barcode_scanner"
            app:tint="@color/white"
            android:contentDescription="Mode icon"/>

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Barcode Scanner"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_arrow_back"
        android:background="@drawable/bg_search_pill"
        android:backgroundTint="#CC000000"
        android:padding="10dp"
        app:tint="@color/white"
        android:contentDescription="Back"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="48dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ─── Scan Frame Overlay (corners effect) ───────────────────────────── -->
    <FrameLayout
        android:id="@+id/scanFrame"
        android:layout_width="260dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top-left corner -->
        <View android:layout_width="36dp" android:layout_height="4dp"
            android:background="@color/white"
            android:layout_gravity="top|start"/>
        <View android:layout_width="4dp" android:layout_height="36dp"
            android:background="@color/white"
            android:layout_gravity="top|start"/>

        <!-- Top-right corner -->
        <View android:layout_width="36dp" android:layout_height="4dp"
            android:background="@color/white"
            android:layout_gravity="top|end"/>
        <View android:layout_width="4dp" android:layout_height="36dp"
            android:background="@color/white"
            android:layout_gravity="top|end"/>

        <!-- Bottom-left corner -->
        <View android:layout_width="36dp" android:layout_height="4dp"
            android:background="@color/white"
            android:layout_gravity="bottom|start"/>
        <View android:layout_width="4dp" android:layout_height="36dp"
            android:background="@color/white"
            android:layout_gravity="bottom|start"/>

        <!-- Bottom-right corner -->
        <View android:layout_width="36dp" android:layout_height="4dp"
            android:background="@color/white"
            android:layout_gravity="bottom|end"/>
        <View android:layout_width="4dp" android:layout_height="36dp"
            android:background="@color/white"
            android:layout_gravity="bottom|end"/>
    </FrameLayout>

    <!-- ─── Bottom Panel (idle: scan button / active: result card) ──────── -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5EDE8"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ── IDLE STATE: Capture Button ── -->
        <LinearLayout
            android:id="@+id/idlePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Point camera at barcode and tap Scan"
                android:textColor="#8D6E63"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="📷  Scan Now"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="@color/brown_primary"
                app:cornerRadius="30dp"/>
        </LinearLayout>

        <!-- ── RESULT STATE: Product Info Card ── -->
        <LinearLayout
            android:id="@+id/resultPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="20dp">

            <!-- Header row: success icon + title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivResultIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="#4CAF50"
                    android:contentDescription="Success"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvResultTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Product Found"
                        android:textColor="#3E2723"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/tvResultType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Barcode Scan"
                        android:textColor="#8D6E63"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#D7CCC8" android:layout_marginBottom="14dp"/>

            <!-- Scrollable Key-Value Info Rows (prevents overflow on long ingredient lists) -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="true"
                android:scrollbars="vertical"
                android:maxHeight="180dp">

                <!-- Key-Value Info Rows Container -->
                <LinearLayout
                    android:id="@+id/infoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#D7CCC8" android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"/>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveToHistory"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="💾  Save"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:backgroundTint="@color/brown_primary"
                    app:cornerRadius="26dp"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnScanAgain"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="🔄  Scan Again"
                    android:textColor="@color/brown_primary"
                    android:textSize="15sp"
                    android:backgroundTint="#EFEBE9"
                    app:cornerRadius="26dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Loading state -->
        <LinearLayout
            android:id="@+id/loadingPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/brown_primary"/>

            <TextView
                android:id="@+id/tvLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fetching product details..."
                android:textColor="#5D4037"
                android:textSize="15sp"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Mic FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_mic"
        app:fabSize="normal"
        app:backgroundTint="@color/brown_primary"
        app:tint="@color/white"
        android:contentDescription="Tap to speak"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"/>

    <!-- Voice Status Banner -->
    <TextView
        android:id="@+id/tvVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎤 Listening..."
        android:textColor="@color/white"
        android:textSize="14sp"
        android:background="@drawable/bg_search_pill"
        android:backgroundTint="#80000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
