<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient"
    tools:context=".activities.SplashActivity">

    <!-- Container for centered content -->
    <LinearLayout
        android:id="@+id/splashContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App Logo with Elevation -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/saharaa_logo"
            android:scaleType="centerCrop"
            android:elevation="10dp"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:strokeColor="@color/brown_primary"
            app:strokeWidth="2dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="Saharaa App Logo"/>

        <!-- App Name -->
        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saharaa"
            android:textSize="40sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/brown_primary" />

        <TextView
            android:id="@+id/tvSplashSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vision Beyond Sight"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/text_secondary_light" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>